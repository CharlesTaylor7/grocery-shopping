{
  "nodeModulesDir": "manual",
  "tasks": {
    "check": "deno fmt --check . && deno lint . && deno check",
    "dev": "vite --host localhost --port 3000",
    "build": "vite build",
    "start": "deno serve -A _fresh/server.js",
    "update": "deno run -A -r jsr:@fresh/update ."
  },
  "unstable": [
    "cron"
  ],
  "lint": {
    "rules": {
      "tags": [
        "fresh",
        "recommended"
      ]
    }
  },
  "exclude": [
    "**/_fresh/*",
    ".nvim/",
    "old/",
    "debug/"
  ],
  "imports": {
    "@/": "./src/",
    "@base-ui/react": "npm:@base-ui/react@^1.6.0",
    "@better-auth-ui/core": "npm:@better-auth-ui/core@^1.6.27",
    "@better-auth-ui/react": "npm:@better-auth-ui/react@^1.6.27",
    "@better-auth/api-key": "npm:@better-auth/api-key@^1.6.23",
    "@better-auth/passkey": "npm:@better-auth/passkey@^1.6.23",
    "@fontsource-variable/geist": "npm:@fontsource-variable/geist@^5.3.0",
    "@neon/serverless": "jsr:@neon/serverless@^1.0.1",
    "@neondatabase/neon-js": "npm:@neondatabase/neon-js@^0.6.2-beta",
    "@react-email/components": "npm:@react-email/components@^1.0.12",
    "@tanstack/react-pacer": "npm:@tanstack/react-pacer@^0.22.1",
    "@tanstack/react-query": "npm:@tanstack/react-query@^5.101.4",
    "better-auth": "npm:better-auth@^1.6.23",
    "bowser": "npm:bowser@^2.14.1",
    "class-variance-authority": "npm:class-variance-authority@^0.7.1",
    "clsx": "npm:clsx@^2.1.1",
    "daisyui": "npm:daisyui@^5.5.19",
    "date-fns": "npm:date-fns@^4.4.0",
    "fresh": "jsr:@fresh/core@^2.3.3",
    "install": "npm:install@^0.13.0",
    "lucide-react": "npm:lucide-react@^1.25.0",
    "neondatabase": "npm:neondatabase@^0.0.1-security",
    "npm": "npm:npm@^12.0.1",
    "preact": "npm:preact@^10.29.1",
    "@preact/signals": "npm:@preact/signals@^2.9.0",
    "@fresh/plugin-vite": "jsr:@fresh/plugin-vite@^1.0.8",
    "radix-ui": "npm:radix-ui@^1.6.4",
    "react-day-picker": "npm:react-day-picker@^10.0.1",
    "shadcn": "npm:shadcn@^4.13.1",
    "sonner": "npm:sonner@^2.0.7",
    "superjson": "npm:superjson@^2.2.6",
    "tailwind-merge": "npm:tailwind-merge@^3.6.0",
    "tw-animate-css": "npm:tw-animate-css@^1.4.0",
    "vite": "npm:vite@^8.1.5",
    "tailwindcss": "npm:tailwindcss@^4.3.3",
    "@tailwindcss/vite": "npm:@tailwindcss/vite@^4.2.1"
  },
  "compilerOptions": {
    "lib": [
      "dom",
      "dom.asynciterable",
      "dom.iterable",
      "deno.ns",
      "deno.unstable"
    ],
    "jsx": "precompile",
    "jsxImportSource": "preact",
    "jsxPrecompileSkipElements": [
      "a",
      "img",
      "source",
      "body",
      "html",
      "head",
      "title",
      "meta",
      "script",
      "link",
      "style",
      "base",
      "noscript",
      "template"
    ],
    "types": [
      "vite/client"
    ]
  }
}
