{
  "name": "neon-js-monorepo",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@9.15.9",
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "link": "cd packages/auth && pnpm link",
    "build": "pnpm --filter '@neondatabase/auth' run build"
  },
  "devDependencies": {
    "tsdown": "0.17.0",
    "typescript": "5.9.3",
    "vite-tsconfig-paths": "5.1.4"
  },
  "pnpm": {
    "overrides": {
      "better-auth": "1.4.18",
      "@better-auth/core": "1.4.18",
      "@better-auth/utils": "0.3.0",
      "@better-auth/passkey": "1.4.18",
      "@better-auth/telemetry": "1.4.18",
      "@better-fetch/fetch": "1.1.21",
      "better-call": "1.1.8",
      "tailwindcss": "4.2.1",
      "@tailwindcss/cli": "4.2.1",
      "@tailwindcss/oxide": "4.2.1",
      "next": "16.2.6",
      "vitest": "4.1.7",
      "defu": "6.1.7",
      "vite": "7.3.2",
      "fastify": ">=5.8.5"
    }
  }
}
